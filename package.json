{
  "name": "pi-theme-builder",
  "version": "1.0.0",
  "description": "Browser-based theme editor for Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belewer/theme-builder-pi.git"
  },
  "homepage": "https://github.com/belewer/theme-builder-pi#readme",
  "bugs": {
    "url": "https://github.com/belewer/theme-builder-pi/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --check app.js",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm run check && npm run typecheck && npm run test:package"
  },
  "keywords": [
    "pi-package",
    "pi",
    "themes"
  ],
  "files": [
    "extensions",
    "app.js",
    "index.html",
    "style.css",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/belewer/theme-builder-pi/1.0.0/assets/pi-themes.png",
    "video": "https://raw.githubusercontent.com/belewer/theme-builder-pi/1.0.0/assets/demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
